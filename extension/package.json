{
  "name": "multiplayer-cli-vscode",
  "displayName": "multiplayer-cli",
  "description": "Share one AI session with your team. Everyone sees the same transcript, and nothing is sent to the model until the room agrees.",
  "version": "0.6.0",
  "license": "MIT",
  "publisher": "fathyshalaby",
  "author": "Fathy Shalaby (https://github.com/fathyshalaby)",
  "repository": { "type": "git", "url": "git+https://github.com/fathyshalaby/multiplayer-cli.git" },
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other"],
  "keywords": ["ai", "collaboration", "multiplayer", "pair programming", "claude", "codex", "copilot", "cursor"],
  "icon": "media/icon.png",
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        { "id": "multiplayer", "title": "multiplayer", "icon": "media/activity.svg" }
      ]
    },
    "views": {
      "multiplayer": [
        { "id": "multiplayer.room", "name": "Room", "type": "webview" }
      ]
    },
    "commands": [
      { "command": "multiplayer.share", "title": "Share this folder as a session", "category": "multiplayer" },
      { "command": "multiplayer.join", "title": "Join a session", "category": "multiplayer" },
      { "command": "multiplayer.propose", "title": "Propose to the room", "category": "multiplayer" },
      { "command": "multiplayer.approve", "title": "Approve the pending proposal", "category": "multiplayer" },
      { "command": "multiplayer.veto", "title": "Veto the pending proposal", "category": "multiplayer" },
      { "command": "multiplayer.say", "title": "Say something to the room", "category": "multiplayer" },
      { "command": "multiplayer.stop", "title": "Interrupt the model", "category": "multiplayer" },
      { "command": "multiplayer.copyLink", "title": "Copy the invite link", "category": "multiplayer" },
      { "command": "multiplayer.leave", "title": "Leave the session", "category": "multiplayer" }
    ],
    "keybindings": [
      { "command": "multiplayer.propose", "key": "ctrl+alt+p", "mac": "cmd+alt+p" },
      { "command": "multiplayer.approve", "key": "ctrl+alt+y", "mac": "cmd+alt+y" },
      { "command": "multiplayer.veto", "key": "ctrl+alt+n", "mac": "cmd+alt+n" }
    ],
    "configuration": {
      "title": "multiplayer",
      "properties": {
        "multiplayer.backend": {
          "type": "string",
          "default": "",
          "enum": ["", "anthropic", "claude-code", "codex", "copilot", "opencode", "opencode-json", "echo"],
          "enumDescriptions": [
            "Detect whichever coding CLI is installed",
            "Claude via the API — the room also votes on tool calls",
            "A real `claude` session, shared",
            "OpenAI Codex",
            "GitHub Copilot CLI",
            "OpenCode",
            "OpenCode with structured events",
            "Offline demo backend — no key, no spend"
          ],
          "description": "Which AI runs a session you host. Empty means detect."
        },
        "multiplayer.policy": {
          "type": "string",
          "default": "team",
          "enum": ["solo", "pair", "team", "strict", "host", "round-robin"],
          "description": "How the room decides what gets sent."
        },
        "multiplayer.relay": {
          "type": "string",
          "default": "",
          "description": "Relay to serve through, so teammates need no route to you. Empty binds to your local network."
        }
      }
    }
  },
  "scripts": {
    "build": "node ../scripts/build-extension.mjs",
    "package": "npm run build && vsce package --no-dependencies --out multiplayer-cli.vsix"
  }
}
