{
  "name": "multiplayer-cli-vscode",
  "displayName": "multiplayer-cli",
  "description": "Share one AI session with your team. Everyone sees the same transcript, and nothing is sent to the model until the room agrees.",
  "version": "0.12.0",
  "license": "MIT",
  "publisher": "fathyshalaby",
  "author": "Fathy Shalaby (https://github.com/fathyshalaby)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fathyshalaby/multiplayer-cli.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "ai",
    "collaboration",
    "multiplayer",
    "pair programming",
    "claude",
    "codex",
    "copilot",
    "cursor"
  ],
  "icon": "media/icon.png",
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "multiplayer",
          "title": "multiplayer",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "multiplayer": [
        {
          "id": "multiplayer.room",
          "name": "Room",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "multiplayer.share",
        "title": "Share this folder as a session",
        "category": "multiplayer"
      },
      {
        "command": "multiplayer.join",
        "title": "Join a session",
        "category": "multiplayer"
      },
      {
        "command": "multiplayer.propose",
        "title": "Propose to the room",
        "category": "multiplayer"
      },
      {
        "command": "multiplayer.approve",
        "title": "Approve the pending proposal",
        "category": "multiplayer"
      },
      {
        "command": "multiplayer.veto",
        "title": "Veto the pending proposal",
        "category": "multiplayer"
      },
      {
        "command": "multiplayer.say",
        "title": "Say something to the room",
        "category": "multiplayer"
      },
      {
        "command": "multiplayer.stop",
        "title": "Interrupt the model",
        "category": "multiplayer"
      },
      {
        "command": "multiplayer.copyLink",
        "title": "Copy the invite link",
        "category": "multiplayer"
      },
      {
        "command": "multiplayer.leave",
        "title": "Leave the session",
        "category": "multiplayer"
      }
    ],
    "keybindings": [
      {
        "command": "multiplayer.propose",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p"
      },
      {
        "command": "multiplayer.approve",
        "key": "ctrl+alt+y",
        "mac": "cmd+alt+y"
      },
      {
        "command": "multiplayer.veto",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n"
      }
    ],
    "configuration": {
      "title": "multiplayer",
      "properties": {
        "multiplayer.backend": {
          "type": "string",
          "default": "",
          "enum": [
            "",
            "claude-code",
            "codex",
            "copilot",
            "opencode",
            "opencode-json",
            "gemini",
            "cursor",
            "aider",
            "amp",
            "echo"
          ],
          "enumDescriptions": [
            "Detect whichever coding CLI is installed",
            "A real `claude` session, shared",
            "OpenAI Codex",
            "GitHub Copilot CLI",
            "OpenCode",
            "OpenCode with structured events",
            "Google Gemini CLI",
            "Cursor's agent CLI",
            "Aider",
            "Amp",
            "Offline demo backend — no key, no spend"
          ],
          "description": "Which AI runs a session you host. Empty means detect. The API-key `anthropic` backend is CLI-only — it needs an optional package the extension does not bundle."
        },
        "multiplayer.policy": {
          "type": "string",
          "default": "team",
          "enum": [
            "solo",
            "pair",
            "team",
            "strict",
            "host",
            "round-robin"
          ],
          "description": "How the room decides what gets sent."
        },
        "multiplayer.lanes": {
          "type": "number",
          "default": 3,
          "minimum": 0,
          "maximum": 6,
          "description": "Parallel worktrees a bare /race opens, when the folder is a git repository. 0 turns racing off."
        },
        "multiplayer.laneSetup": {
          "type": "string",
          "default": "",
          "description": "Command run in each lane's fresh checkout before the agent starts, e.g. \"npm ci\". A worktree has no ignored files, so a lane has no node_modules until this puts them there."
        },
        "multiplayer.relay": {
          "type": "string",
          "default": "",
          "description": "Relay to serve through, so teammates need no route to you. Empty binds to your local network."
        },
        "multiplayer.lanePreview": {
          "type": "string",
          "default": "",
          "description": "Start each finished lane so the room can look at it rather than only read its diff, e.g. \"npm run dev -- --port {port}\". {port} is substituted and PORT is set in the environment. Empty turns previews off, which is the default — three lanes is three dev servers."
        },
        "multiplayer.lanePreviewPort": {
          "type": "number",
          "default": 4173,
          "minimum": 1024,
          "maximum": 65535,
          "description": "Where preview port hunting starts. Each lane takes the next free one."
        },
        "multiplayer.lanePreviewHost": {
          "type": "string",
          "default": "127.0.0.1",
          "description": "Hostname shown in preview URLs. Localhost is right when the seats are on this machine; set it to the name teammates reach you by if your preview command binds wider."
        }
      }
    }
  },
  "scripts": {
    "build": "node ../scripts/build-extension.mjs",
    "package": "npm run build && vsce package --no-dependencies --out multiplayer-cli.vsix"
  }
}
