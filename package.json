{
  "name": "multiplayer-cli",
  "version": "0.12.0",
  "description": "Make your AI session multiplayer: a shared terminal AI session your team prompts together, with group consent on every turn.",
  "type": "module",
  "bin": {
    "mpx": "./dist/src/cli.js",
    "multiplayer": "./dist/src/cli.js"
  },
  "main": "./dist/src/lib.js",
  "types": "./dist/src/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/lib.d.ts",
      "default": "./dist/src/lib.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/src",
    "skills",
    ".claude-plugin",
    "gemini-extension",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-web.mjs",
    "prepare": "npm run build",
    "test": "npm run build && node --test --test-concurrency=2 dist/test/*.test.js",
    "start": "npm run build && node dist/src/cli.js",
    "build:extension": "node scripts/build-extension.mjs",
    "build:browser-extension": "node scripts/build-browser-extension.mjs",
    "test:vscode": "node extension/test/runTest.mjs",
    "sync": "node scripts/sync-integrations.mjs"
  },
  "keywords": [
    "cli",
    "ai",
    "claude",
    "multiplayer",
    "collaboration",
    "pair-programming",
    "tui"
  ],
  "license": "MIT",
  "dependencies": {
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@types/chrome": "^0.3.0",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.134.0",
    "@types/ws": "^8.5.12",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0"
  },
  "optionalDependencies": {
    "playwright": "^1.50.0"
  },
  "author": "Fathy Shalaby (https://github.com/fathyshalaby)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fathyshalaby/multiplayer-cli.git"
  },
  "bugs": {
    "url": "https://github.com/fathyshalaby/multiplayer-cli/issues"
  },
  "homepage": "https://github.com/fathyshalaby/multiplayer-cli#readme",
  "peerDependencies": {
    "@anthropic-ai/sdk": "^0.120.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    }
  }
}
